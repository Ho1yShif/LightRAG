# LightRAG on Render — minimal environment
# Copy to .env and fill in the values marked "REQUIRED". .env is gitignored.
# The full list of every advanced option lives in env.example.

# --- Server ---
HOST=0.0.0.0
PORT=9621
WORKING_DIR=/app/data/rag_storage   # knowledge graph + vector store (on the Render disk)
INPUT_DIR=/app/data/inputs          # uploaded documents

# --- Access control ---
# Protects the deployed server + Web UI. Choose a strong random secret. REQUIRED.
LIGHTRAG_API_KEY=your-strong-secret-here

# --- CORS (cross-origin browser access) ---
# On Render, render.yaml defaults this to the service's own origin
# (RENDER_EXTERNAL_URL) rather than "*". The Web UI is served same-origin so it
# never needs CORS, and the API is authenticated with the X-API-Key header, not
# cookies. Set an explicit allowlist only if you put a SEPARATE-origin frontend
# in front of the API; never use "*" with a credentialed/cookie-based frontend.
# Locally (no RENDER_EXTERNAL_URL), LightRAG's own "*" default applies if unset.
# CORS_ORIGINS=https://your-frontend.example.com

# --- LLM (OpenAI by default; swappable via LLM_BINDING) ---
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini
LLM_BINDING_API_KEY=sk-...           # your OpenAI API key. REQUIRED.

# --- Embeddings (OpenAI by default; swappable via EMBEDDING_BINDING) ---
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
EMBEDDING_BINDING_API_KEY=sk-...     # same OpenAI API key. REQUIRED.
